# Google Sheets Configuration - CORS-friendly methods
# Choose ONE of the methods below:

# METHOD 1: CSV Export (Easiest - works immediately)
# Just make your spreadsheet public and use the spreadsheet ID below
GOOGLE_SPREADSHEET_ID=https://docs.google.com/spreadsheets/d/e/2PACX-1vRGa4amn06lOkQgmga5kqmQnEwH3avKk5Sxgu5Kd2TcKKbZtTD4IOCu8yDfz-nF46vvilAf15tYirum/pub?output=csv

# Sheet name/tab (optional, defaults to "Sheet1")
GOOGLE_SHEET_NAME=Sheet1

# SETUP INSTRUCTIONS:

# METHOD 1 - CSV Export (Current setup):
# 1. Open your Google Sheet
# 2. Click Share > Change to "Anyone with the link can view" 
# 3. Done! The page will fetch data via CSV export

# Expected spreadsheet columns:
# - Name (Common name of the plant)
# - Scientific Name (Scientific/Latin name)  
# - Location Found (Where you spotted it)
# - Date Spotted (When you found it)
# - Notes (Additional observations)
# - Photo (URL to photo or image filename)